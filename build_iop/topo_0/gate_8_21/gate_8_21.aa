// GPP[release]
// DEVICE 0

.output "gi1" float32 320 strided
.logical_shape 2,2,320
.split 320
East 4 @ 1, East 5 @ 1, East 6 @ 1, East 7 @ 1
East 4 @ 3, East 5 @ 3, East 6 @ 3, East 7 @ 3
East 4 @ 1, East 5 @ 1, East 6 @ 1, East 7 @ 1
East 4 @ 3, East 5 @ 3, East 6 @ 3, East 7 @ 3
.output "gi0" float32 320 strided
.logical_shape 2,2,320
.split 320
East 12 @ 0, East 13 @ 0, East 14 @ 0, East 15 @ 0
East 12 @ 2, East 13 @ 2, East 14 @ 2, East 15 @ 2
East 12 @ 0, East 13 @ 0, East 14 @ 0, East 15 @ 0
East 12 @ 2, East 13 @ 2, East 14 @ 2, East 15 @ 2
.output "gr1" float32 320 strided
.logical_shape 2,2,320
.split 320
East 0 @ 1, East 1 @ 1, East 2 @ 1, East 3 @ 1
East 0 @ 3, East 1 @ 3, East 2 @ 3, East 3 @ 3
East 0 @ 1, East 1 @ 1, East 2 @ 1, East 3 @ 1
East 0 @ 3, East 1 @ 3, East 2 @ 3, East 3 @ 3
.output "gr0" float32 320 strided
.logical_shape 2,2,320
.split 320
East 8 @ 0, East 9 @ 0, East 10 @ 0, East 11 @ 0
East 8 @ 2, East 9 @ 2, East 10 @ 2, East 11 @ 2
East 8 @ 0, East 9 @ 0, East 10 @ 0, East 11 @ 0
East 8 @ 2, East 9 @ 2, East 10 @ 2, East 11 @ 2
.output "Psi_transformed_imag_0" float32 256 strided
.logical_shape 4,256
.split 256
West 4 @ 0, West 5 @ 0, West 6 @ 0, West 7 @ 0
West 4 @ 4096, West 5 @ 4096, West 6 @ 4096, West 7 @ 4096
West 4 @ 1, West 5 @ 1, West 6 @ 1, West 7 @ 1
West 4 @ 4097, West 5 @ 4097, West 6 @ 4097, West 7 @ 4097
.output "Psi_transformed_real_0" float32 256 strided
.logical_shape 4,256
.split 256
West 0 @ 0, West 1 @ 0, West 2 @ 0, West 3 @ 0
West 0 @ 4096, West 1 @ 4096, West 2 @ 4096, West 3 @ 4096
West 0 @ 1, West 1 @ 1, West 2 @ 1, West 3 @ 1
West 0 @ 4097, West 1 @ 4097, West 2 @ 4097, West 3 @ 4097

.unit VXM 4
18:    and float32, SG4_3_w, SG4_3_w, SG4_5_w
