// GPP[release]
// DEVICE 0

.output "gate_kernel_real_0" float32 320 strided
.logical_shape 320
.split 320
East 8 @ 4, East 9 @ 4, East 10 @ 4, East 11 @ 4
.output "gate_kernel_imag_0" float32 320 strided
.logical_shape 320
.split 320
East 12 @ 4, East 13 @ 4, East 14 @ 4, East 15 @ 4

.unit Mem East 7
.write 0
48:    write 0, S_11_w // gate_kernel_broadcasted_imag_0_00
50:    write 1, S_11_w // gate_kernel_broadcasted_imag_0_01
52:    write 2, S_11_w // gate_kernel_broadcasted_imag_0_10
54:    write 3, S_11_w // gate_kernel_broadcasted_imag_0_11

.unit Mem East 3
.write 0
48:    write 0, S_11_w // gate_kernel_broadcasted_real_0_00
50:    write 1, S_11_w // gate_kernel_broadcasted_real_0_01
52:    write 2, S_11_w // gate_kernel_broadcasted_real_0_10
54:    write 3, S_11_w // gate_kernel_broadcasted_real_0_11

.unit Mem East 2
.write 0
48:    write 0, S_10_w // gate_kernel_broadcasted_real_0_00
50:    write 1, S_10_w // gate_kernel_broadcasted_real_0_01
52:    write 2, S_10_w // gate_kernel_broadcasted_real_0_10
54:    write 3, S_10_w // gate_kernel_broadcasted_real_0_11

.unit Selector East
.dp 0
31:    bcast S_8_w, 0b0000
32:    bcast S_8_w, 0b0000
33:    bcast S_8_w, 0b0000
34:    bcast S_8_w, 0b0000
35:    bcast S_8_w, 0b0000
36:    bcast S_8_w, 0b0000
37:    bcast S_8_w, 0b0000
38:    bcast S_8_w, 0b0000

.unit Permutor East
.up 0
27:    bcast SG4_1, NEW, NEW, NEW, NEW
28:    bcast SG4_1, NEW, NEW, NEW, NEW
29:    bcast SG4_1, NEW, NEW, NEW, NEW
30:    bcast SG4_1, NEW, NEW, NEW, NEW
31:    bcast SG4_1, NEW, NEW, NEW, NEW
32:    bcast SG4_1, NEW, NEW, NEW, NEW
33:    bcast SG4_1, NEW, NEW, NEW, NEW
34:    bcast SG4_1, NEW, NEW, NEW, NEW

.unit Distributor East
.dp 0
26:    dist S_12, 0b00001111
27:    dist reuse, 15
28:    dist S_12, 0b00001111
29:    dist reuse, 15
30:    dist S_12, 0b00001111
31:    dist reuse, 15
32:    dist S_12, 0b00001111
33:    dist reuse, 15

.unit Mem East 15
.read 0
14:    read 4, S_7_e // gate_kernel_imag_0.read
16:    read 4, S_7_e // gate_kernel_imag_0.read
18:    read 4, S_7_e // gate_kernel_imag_0.read
20:    read 4, S_7_e // gate_kernel_imag_0.read

.write 0
11:    write 4, S_3_w // gate_kernel_imag_0
46:    write 0, S_11_w // gate_kernel_broadcasted_imag_0_00
48:    write 1, S_11_w // gate_kernel_broadcasted_imag_0_01
50:    write 2, S_11_w // gate_kernel_broadcasted_imag_0_10
52:    write 3, S_11_w // gate_kernel_broadcasted_imag_0_11

.unit Mem East 10
